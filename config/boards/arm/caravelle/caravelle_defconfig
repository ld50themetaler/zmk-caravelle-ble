CONFIG_SOC_SERIES_NRF52X=y
CONFIG_SOC_NRF52832_QFAA=y
CONFIG_BOARD_CARAVELLE=y

# Enable MPU
CONFIG_ARM_MPU=y
CONFIG_MPU_ALLOW_FLASH_WRITE=y

# Enable GPIO
CONFIG_GPIO=y

# Enable ADC
CONFIG_ADC=y
CONFIG_ADC_NRFX_SAADC=y

# Clock (RC Oscillator)
CONFIG_CLOCK_CONTROL_NRF=y
CONFIG_CLOCK_CONTROL_NRF_K32SRC_RC=y
CONFIG_CLOCK_CONTROL_NRF_K32SRC_500PPM=y
CONFIG_BT_CTLR_XTAL_ADVANCED=n


# Storage / NVS for Bluetooth bonding and settings
CONFIG_NVS=y
CONFIG_SETTINGS_NVS=y
CONFIG_FLASH=y
CONFIG_FLASH_PAGE_LAYOUT=y
CONFIG_FLASH_MAP=y
CONFIG_SETTINGS=y

# Enable code partition offset for bootloader compatibility (0x1F000)
CONFIG_USE_DT_CODE_PARTITION=y

# ZMK Bluetooth enabled, USB disabled (nRF52832 has no native USB controller)
CONFIG_ZMK_BLE=y
CONFIG_ZMK_USB=n



CONFIG_USB_DEVICE_STACK=n
